rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global helpers
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    // Roles (Lookup required for secure role-based access)
    // Note: get() lookups are cached per request.
    function getUserData(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }
    function hasRole(role) {
      return isSignedIn() && getUserData(request.auth.uid).data.get('role', 'buyer') == role;
    }
    function isAdmin() {
       let userDoc = getUserData(request.auth.uid);
       return isSignedIn() && userDoc != null && userDoc.data.get('role', 'buyer') == 'admin';
    }
    function isAgent() {
       let userDoc = getUserData(request.auth.uid);
       return isSignedIn() && userDoc != null && userDoc.data.get('role', 'buyer') == 'agent';
    }
    function isProducer() {
       let userDoc = getUserData(request.auth.uid);
       return isSignedIn() && userDoc != null && userDoc.data.get('role', 'buyer') == 'producer';
    }

    // User Rules
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'name', 'role', 'createdAt']) &&
             data.uid == request.auth.uid &&
             data.name is string && data.name.size() <= 100 &&
             data.role in ['producer', 'buyer', 'agent'] &&
             data.createdAt == request.time;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(userId) && userId == request.auth.uid && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'bio', 'photoUrl', 'phone']) &&
        incoming().name is string && incoming().name.size() <= 100
      );
    }

    // Region Rules (Public read, Admin write)
    match /regions/{regionId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(regionId);
    }

    // Product Rules
    function isValidProduct(data) {
      return data.keys().hasAll(['nameAr', 'nameEn', 'category', 'regionId', 'producerId', 'price', 'currency', 'qualityStatus', 'createdAt']) &&
             data.nameAr is string && data.nameAr.size() <= 200 &&
             data.nameEn is string && data.nameEn.size() <= 200 &&
             data.price is number && data.price >= 0 &&
             data.producerId == request.auth.uid &&
             data.qualityStatus == 'pending' &&
             data.createdAt == request.time;
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if isProducer() && isValidId(productId) && isValidProduct(incoming());
      allow update: if isValidId(productId) && (
        (isOwner(existing().producerId) && (
          incoming().diff(existing()).affectedKeys().hasOnly(['nameAr', 'nameEn', 'descriptionAr', 'descriptionEn', 'category', 'regionId', 'price', 'currency', 'imageUrl', 'audioStoryUrl', 'stock', 'tags'])
        )) || (isAgent() && (
          incoming().diff(existing()).affectedKeys().hasOnly(['qualityStatus'])
        )) || isAdmin()
      );
      allow delete: if isValidId(productId) && (isOwner(existing().producerId) || isAdmin());
    }

    // Order Rules
    function isValidOrder(data) {
      return data.keys().hasAll(['buyerId', 'items', 'totalAmount', 'status', 'createdAt']) &&
             data.buyerId == request.auth.uid &&
             data.totalAmount is number &&
             data.items is list &&
             data.items.size() > 0 &&
             data.status == 'pending' &&
             data.createdAt == request.time;
    }

    match /orders/{orderId} {
      allow read: if isSignedIn() && (isOwner(resource.data.buyerId) || isAdmin());
      allow create: if isSignedIn() && isValidId(orderId) && isValidOrder(incoming());
      allow update: if isAdmin() && isValidId(orderId);
    }

    // Wishlist Rules
    function isValidWishlist(data) {
      return data.keys().hasAll(['userId', 'productId', 'createdAt']) &&
             data.userId == request.auth.uid &&
             data.productId is string &&
             data.createdAt == request.time;
    }

    match /wishlists/{wishlistId} {
      allow read: if isSignedIn() && (isOwner(resource.data.userId) || isAdmin());
      allow create: if isSignedIn() && isValidId(wishlistId) && isValidWishlist(incoming());
      allow delete: if isSignedIn() && isValidId(wishlistId) && isOwner(existing().userId);
    }

    // Review Rules
    function isValidReview(data) {
      return data.keys().hasAll(['userId', 'productId', 'rating', 'comment', 'createdAt']) &&
             data.userId == request.auth.uid &&
             data.productId is string &&
             data.rating is number && data.rating >= 1 && data.rating <= 5 &&
             data.comment is string && data.comment.size() <= 1000 &&
             data.createdAt == request.time;
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(reviewId) && isValidReview(incoming());
      allow update: if isSignedIn() && isValidId(reviewId) && isOwner(existing().userId) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['rating', 'comment']) &&
        incoming().rating is number && incoming().rating >= 1 && incoming().rating <= 5 &&
        incoming().comment is string && incoming().comment.size() <= 1000;
      allow delete: if isSignedIn() && isValidId(reviewId) && (isOwner(existing().userId) || isAdmin());
    }

    // Verification Reports
    match /verifications/{reportId} {
      allow read: if isSignedIn();
      allow create: if isAgent() && isValidId(reportId) && incoming().agentId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
